# Shared infrastructure
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.your-project.supabase.co:5432/postgres
REDIS_URL=redis://redis:6379

# GitHub credentials. Limit the token to only the repositories and permissions required.
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Optional Groq AI review. Leave the key empty to use the heuristic reviewer.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Internal service URLs and ports
GITHUB_SERVICE_URL=http://github-service:8081
API_GATEWAY_PORT=8080
GITHUB_SERVICE_PORT=8081
WEBHOOK_SERVICE_PORT=8082
